{
    "id": "set-as-background",
    "name": "Set as Background",
    "description": "Adds \"Set as Background\" to the right-click menu of a picture (GNOME).",
    "version": "@PROJECT_VERSION@",
    "author": "Argonaut",
    "protocol": 1,
    "start": "when-needed",
    "commands": [{"id": "set", "label": "Set as Background", "kind": "files", "multiple": false, "types": ["image/*"]}],
    "exec": ["@ARGONAUT_DESKTOP_EXTENSION_EXE@", "background"]
}
