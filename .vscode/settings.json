{
  // Build: CMake Tools drives CMakePresets.json (Debug / Release).
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.buildBeforeRun": true,
  // Status-bar "Debug" button: show Qt types (QString, QList…) readably.
  "cmake.debugConfig": {
    "MIMode": "gdb",
    "visualizerFile": "${command:qt-cpp.natvis6}",
    "showDisplayString": true
  },

  // IntelliSense comes from CMake (compile_commands), so Qt headers resolve.
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  // Fallback if no CMake preset is selected yet (created by `cmake --preset debug`).
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.clang_format_style": "file",

  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modifications",
    "editor.rulers": [100]
  },
  "files.associations": { "*.h": "cpp" },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": { "build/": true },
  "search.exclude": { "build/": true }
}
