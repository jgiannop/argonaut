[Desktop Entry]
Type=Application
Name=Kosmos
GenericName=File Manager
Comment=Browse and organize your files
Keywords=folder;manager;explore;disk;filesystem;files;nautilus;
Exec=@KOSMOS_EXE@ %U
TryExec=@KOSMOS_EXE@
Icon=kosmos
Terminal=false
StartupNotify=true
StartupWMClass=kosmos
Categories=Qt;System;FileTools;FileManager;
MimeType=inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@KOSMOS_EXE@
